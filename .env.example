# ConvoSketchpad Canvas configuration

# OpenClaw Gateway
GATEWAY_URL=http://127.0.0.1:18789
GATEWAY_TOKEN=
# Required for accurate daily Session-reset prediction when the Gateway is remote.
# CONVOSKETCHPAD_GATEWAY_TIMEZONE=Asia/Shanghai

# HTTP server
PORT=3080
HOST=127.0.0.1
# SSL_PORT=3443

# Optional browser-facing origin used for server-side Gateway RPC fallback.
# CONVOSKETCHPAD_PUBLIC_ORIGIN=https://convosketchpad.example.com

# Managed user authentication. Enable this before exposing the server remotely.
CONVOSKETCHPAD_AUTH=false
# CONVOSKETCHPAD_SESSION_SECRET=replace-with-a-long-random-secret
# CONVOSKETCHPAD_SESSION_TTL=2592000000
# CONVOSKETCHPAD_AUTH_MAX_FAILURES=3
# CONVOSKETCHPAD_AUTH_FAILURE_WINDOW=1800000
# CONVOSKETCHPAD_AUTH_LOCKOUT=1800000

# Network policy
# CONVOSKETCHPAD_ALLOW_INSECURE=false
# WS_ALLOWED_HOSTS=canvas.example.com
# ALLOWED_ORIGINS=https://canvas.example.com
# CSP_CONNECT_EXTRA=wss://gateway.example.com
# TRUSTED_PROXIES=127.0.0.1

# ConvoSketchpad-owned state
# CONVOSKETCHPAD_DATA_DIR=~/.convosketchpad

# Passed through to the OpenClaw CLI only. ConvoSketchpad never reads this file.
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
