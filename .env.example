# ConvoSketchpad Canvas configuration

# OpenClaw Gateway
GATEWAY_URL=http://127.0.0.1:18789
GATEWAY_TOKEN=

# HTTP server
PORT=3080
HOST=127.0.0.1
# SSL_PORT=3443

# Optional browser-facing origin used for server-side Gateway RPC fallback.
# NERVE_PUBLIC_ORIGIN=https://convosketchpad.example.com

# Managed user authentication. Enable this before exposing the server remotely.
NERVE_AUTH=false
# NERVE_SESSION_SECRET=replace-with-a-long-random-secret
# NERVE_SESSION_TTL=2592000000
# NERVE_AUTH_MAX_FAILURES=3
# NERVE_AUTH_FAILURE_WINDOW=1800000
# NERVE_AUTH_LOCKOUT=1800000

# Network policy
# NERVE_ALLOW_INSECURE=false
# WS_ALLOWED_HOSTS=canvas.example.com
# ALLOWED_ORIGINS=https://canvas.example.com
# CSP_CONNECT_EXTRA=wss://gateway.example.com

# Canvas attachment workspace and usage accounting
# NERVE_WORKSPACE_ROOT=~/.openclaw/workspace
# SESSIONS_DIR=~/.openclaw/agents/main/sessions
# USAGE_FILE=~/.openclaw/token-usage.json

# OpenClaw config override
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
