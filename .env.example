# ConvoSketchpad Canvas 配置

# 启用的 Agent 运行端（Agent Runtime），按此顺序聚合 Agent；当前每种 Adapter 最多一个实例。
AGENT_RUNTIMES=openclaw,codex
# setup 会从已连接 Runtime 返回的目录中选择；两项必须同时设置。
# CONVOSKETCHPAD_DEFAULT_AGENT_RUNTIME=openclaw
# CONVOSKETCHPAD_DEFAULT_AGENT_PROFILE=main

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# 所有模式的 Gateway 共享密钥：本机 RPC 与 Gateway HTTP 都会使用。
OPENCLAW_GATEWAY_TOKEN=
# 远程 Gateway 必须设置此项，才能准确预测每日 Session 重置。
# OPENCLAW_GATEWAY_TIMEZONE=Asia/Shanghai

# ConvoSketchpad 浏览器入口（生产由 Hono 使用，开发由 Vite 使用）
PORT=3080
HOST=127.0.0.1
# ConvoSketchpad 只提供 HTTP；远程 HTTPS 请由反向代理或 Tailscale Serve 终止。

# 受管用户认证。远程开放服务前必须启用。
CONVOSKETCHPAD_AUTH=false
# CONVOSKETCHPAD_SESSION_SECRET=replace-with-a-long-random-secret
# CONVOSKETCHPAD_SESSION_TTL=2592000000
# CONVOSKETCHPAD_AUTH_MAX_FAILURES=3
# CONVOSKETCHPAD_AUTH_FAILURE_WINDOW=1800000
# CONVOSKETCHPAD_AUTH_LOCKOUT=1800000

# 网络策略
# CONVOSKETCHPAD_ALLOW_INSECURE=false
# 必须是浏览器实际访问的精确 Origin；不接受路径、凭据、查询或通配符。
# ALLOWED_ORIGINS=https://canvas.example.com
# 只填写与 ConvoSketchpad 直接建立 TCP 连接的可信代理 IP。
# TRUSTED_PROXIES=127.0.0.1

# ConvoSketchpad 自有状态；相对路径以项目根目录为基准。
# CONVOSKETCHPAD_DATA_DIR=~/.convosketchpad

# 仅透传给 OpenClaw CLI；ConvoSketchpad 绝不会读取该文件。
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# 未设置时直接通过 PATH 调用 openclaw；setup 探测成功后会保存实际绝对路径。
# OPENCLAW_BIN=/usr/local/bin/openclaw

# Codex App Server（最低且已验证版本：Codex CLI 0.146.0）
# 未设置时直接通过 PATH 调用 codex；setup 探测成功后会保存实际绝对路径。
# CODEX_BIN=/usr/local/bin/codex
# Codex 可读写的项目工作目录；setup 默认创建并使用 ~/codex-convosketchpad。
# 它不是 CODEX_HOME（通常为 ~/.codex）。
# 临时交付物位于该目录的 .convosketchpad-artifacts/，持久化后自动清理。
# CODEX_WORKING_DIRECTORY=~/codex-convosketchpad
