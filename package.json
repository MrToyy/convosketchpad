{
  "name": "convosketchpad",
  "version": "0.4.0",
  "description": "A visual branching workspace for OpenClaw — fork conversations with context, attachments, and artifacts intact",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrToyy/convosketchpad.git"
  },
  "homepage": "https://github.com/MrToyy/convosketchpad",
  "keywords": [
    "openclaw",
    "convosketchpad",
    "canvas",
    "design",
    "visual-workspace",
    "branching",
    "ai",
    "agent"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "clean": "node -e \"for (const path of ['dist','server-dist','bin-dist']) require('fs').rmSync(path,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p config/tsconfig.server.json --outDir server-dist --noEmit false --declaration false && tsc -p config/tsconfig.bin.json",
    "update": "node bin-dist/bin/convosketchpad-update.js",
    "uninstall": "bash uninstall.sh",
    "migrate": "node bin-dist/bin/convosketchpad-migrate.js",
    "users": "node bin-dist/bin/convosketchpad-users.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server-dist/index.js",
    "start:server": "tsx server/index.ts",
    "prod": "npm run build && node server-dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "postinstall": "node -e \"try{require('fs').accessSync('.env')}catch{console.log('\\n  Run \\x1b[33mnpm run setup\\x1b[0m to configure ConvoSketchpad.\\n')}\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hono/node-server": "^2.0.11",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "hono": "^4.12.32",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
